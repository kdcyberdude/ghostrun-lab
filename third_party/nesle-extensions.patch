+// slot: 0..3 for $8000/$A000/$C000/$E000. bank: 8 KB page number, wrapped to the image.
+NESLE_CUDA_MAPPER_HD NESLE_CUDA_MAPPER_INLINE void set_prg8(const BatchBuffers& buffers,
+                                                            std::uint32_t env,
+                                                            std::uint32_t slot,
+                                                            std::uint32_t bank) {
